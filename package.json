{
  "name": "HermesChat",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes Agent 桌面/移动客户端（Windows 桌面壳基于 Electron）",
  "author": "HermesChat",
  "main": "desktop/dist/main.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "web": "vite",
    "web:build": "vite build",
    "desktop:build": "tsc -p desktop",
    "desktop:dev": "npm run web:build && npm run desktop:build && electron .",
    "dist:win": "npm run web:build && npm run desktop:build && electron-builder --win",
    "dist:mac": "npm run web:build && npm run desktop:build && electron-builder --mac",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "markdown-it": "^15.0.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.63.0",
    "prettier": "2.8.8",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
